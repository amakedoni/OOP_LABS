if(SCENARIO STREQUAL "symmetric")
    set(input "1\n2 2\n1 2 2 1\n6\n0\n")
    set(expected "Симметрична: да")
elseif(SCENARIO STREQUAL "asymmetric")
    set(input "1 2 2 1 2 3 4 6 0")
    set(expected "Симметрична: нет")
elseif(SCENARIO STREQUAL "rectangular")
    set(input "1 2 3 1 1 1 1 1 1 6 0")
    set(expected "Симметрична: нет")
elseif(SCENARIO STREQUAL "basic")
    set(input "1 1 2 1 2 3 0 1 7 2 4 1 2 3 4 2 5 2 1 1 2 2 0")
    set(expected "Матрица: [[1, 7]]" "Матрица: [[4, 11]]" "Матрица: [[26]]")
elseif(SCENARIO STREQUAL "empty")
    set(input "2 1 2 0 6 1 0 0 6 0")
    set(expected "Матрица: []" "Размер: 0x0" "Матрица: [[], []]" "Размер: 2x0"
        "Симметрична: нет" "Симметрична: да")
elseif(SCENARIO STREQUAL "invalid")
    set(input "nope\n-1\n2.5\n99\n1\n-2\n1 1\nnan\n4\n3\n9 0 3\n2\n0\n")
    set(expected "Ошибка ввода" "Неизвестный пункт" "Ошибка: нет элемента" "Матрица: [[4]]")
elseif(SCENARIO STREQUAL "incompatible")
    set(input "1 1 2 1 2 4 1 1 4 5 1 1 4 2 0")
    set(expected "Ошибка: для сложения" "Ошибка: для умножения" "Матрица: [[1, 2]]")
elseif(SCENARIO STREQUAL "eof")
    set(input "")
    set(expected "Работа завершена.")
elseif(SCENARIO STREQUAL "eof_create")
    set(input "1 2 2 1")
    set(expected "Работа завершена.")
elseif(SCENARIO STREQUAL "no_newline")
    set(input "1 1 1 5 6")
    set(expected "Симметрична: да")
elseif(SCENARIO STREQUAL "long_token")
    string(REPEAT "9" 180 too_long)
    set(input "${too_long}\n0\n")
    set(expected "Ошибка ввода" "Работа завершена.")
else()
    message(FATAL_ERROR "Unknown scenario: ${SCENARIO}")
endif()

set(input_file "${CMAKE_CURRENT_BINARY_DIR}/menu-${SCENARIO}.txt")
file(WRITE "${input_file}" "${input}")
execute_process(COMMAND "${PROGRAM}" INPUT_FILE "${input_file}"
    OUTPUT_VARIABLE output ERROR_VARIABLE errors RESULT_VARIABLE result TIMEOUT 10)
if(NOT result EQUAL 0 OR NOT errors STREQUAL "")
    message(FATAL_ERROR "Program failed: ${result}\n${errors}\n${output}")
endif()
foreach(fragment IN LISTS expected)
    string(FIND "${output}" "${fragment}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing '${fragment}':\n${output}")
    endif()
endforeach()
